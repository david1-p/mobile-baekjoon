{
  "name": "pocket-judge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "editor": "node scripts/build-editor.mjs",
    "postinstall": "npm run editor",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "build": "npm run editor && expo export --platform android --platform ios",
    "test": "npm run editor && node --test tests/*.test.mjs",
    "test:editor": "npm run editor && node tests/editor.browser.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-python": "^6.1.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "codemirror": "^6.0.1",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-sqlite": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.65.1",
    "typescript": "~6.0.3"
  }
}
